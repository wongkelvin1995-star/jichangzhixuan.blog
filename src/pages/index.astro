---
import Layout from '../layouts/Layout.astro';
import brands from '../data/brands.json';
import plans from '../data/plans.json';
import options from '../data/options.json';
import rankings from '../data/rankings.json';

// Compute real dynamic statistics
const totalBrandsCount = brands.length;
const totalPlansCount = plans.length;
const totalOptionsCount = options.length;
const totalDimensionsCount = 23;
const totalToolsCount = 6;

// Top 3 brands for recommendations
const top1 = brands.find(b => b.slug === 'lingdongyun')!;
const top2 = brands.find(b => b.slug === 'twilight')!;
const top3 = brands.find(b => b.slug === 'breezenet')!;

// Representative one-time packages
const onetimeOptions = options.filter(o => o.planType === 'onetime').slice(0, 6);

// Core FAQs
const homeFaqs = [
  {
    q: "机场（科学上网）是什么？适合哪些人使用？",
    a: "机场是基于 Shadowsocks、V2Ray、Trojan、VLESS 等现代代理协议构建的网络加速服务代称。它通过部署在海外或专线机房的节点，帮助用户加速访问国际互联网网络资源。适合需要查阅海外学术文献的高校师生、跨境电商外贸从业人员、需要稳定调用 OpenAI / Claude / Midjourney 等前沿 AI 工具的技术开发者，以及追求海外 4K 超高清流媒体影音娱乐的用户群体。"
  },
  {
    q: "如何判断一个机场品牌是否靠谱？",
    a: "判断机场靠谱程度的核心依据主要有四点：第一是「价目透明与明码标价」，不玩隐藏限速或高倍率偷跑流量；第二是「网络线路真实架构」，明确区分普通公网中转与高成本 IEPL/IPLC 专线；第三是「运营历史与工单响应」，拥有稳定的服务群组与技术客服通道；第四是「客户端兼容性与政策」，清楚说明是否支持通用 Clash / Shadowrocket 订阅导入，避免付费后因客户端限制无法使用。"
  },
  {
    q: "月付、季付、年付有什么区别？我该选哪一种？",
    a: "月付的优势是资金灵活、随用随停，适合新用户初次验证晚高峰稳定性与节点速度；季付提供适度优惠，适合度过磨合期后的稳定进阶用户；年付单月成本通常最低（享 15%-30% 折扣），但必须一次性预付并承担服务商长期运营风险。机场智选建议：新手务必首选「月付」进行体验，在连续 2-3 个月网络稳定满意后，再考虑升级长周期。"
  },
  {
    q: "便宜机场和高端专线机场有什么区别？",
    a: "核心差异在于网络出口架构与晚高峰抗拥堵能力。平价机场多采用普通公网隧道或单线 BGP 转发，在晚高峰（20:00-23:00）国际出口繁忙时容易出现丢包率上升或延迟剧增；而高阶专线机场配置内网独享 IEPL/IPLC 链路，不经过公网审查与国际拥堵骨干网，丢包率极低且全天延迟平稳。但日常如果仅查阅网页或翻译，平价套餐完全足够，无需盲目为高价专线买单。"
  },
  {
    q: "购买机场之前有哪些需要注意的风险？",
    a: "主要包括四大潜在风险：一是长期预付资金风险，部分不知名小品牌在收取大量年付后可能因经营不善出现线路降级甚至停止运营；二是虚假宣传风险，某些商家宣称的'不限设备'或'100%全天4K秒开'往往在晚高峰面临带宽限制；三是退款政策缺失，多数网络服务基于数字交付，通常不支持无理由退款；四是合规使用风险，用户必须严格遵守法律法规，将网络服务仅用于正常的学术研究、跨境贸易、信息检索与技术开发。"
  }
];

// Featured articles
const featuredArticles = [
  {
    slug: '2026-airport-recommendation',
    category: '选购指南',
    readTime: '约 8 分钟阅读',
    image: '/images/articles/article-guide.webp',
    title: '新手如何选机场？一篇看懂核心要点与避坑指南',
    summary: '汇集18家机场真实档案与146条套餐，从预算控制、设备兼容到专线架构，帮你避开低价套路，理性挑选适合自己的机场。'
  },
  {
    slug: '2026-cheap-airport-guide',
    category: '套餐解析',
    readTime: '约 6 分钟阅读',
    image: '/images/articles/article-billing.webp',
    title: '月付与年付怎么选？优缺点对比与适用人群分析',
    summary: '年付折合看似划算，但暗藏预付款与停服风险。从资金周转、退款条款到流量利用率，系统算清月付与年付的真实经济账。'
  },
  {
    slug: 'premium-vs-regular-airport-difference',
    category: '使用技巧',
    readTime: '约 10 分钟阅读',
    image: '/images/articles/article-nodes.webp',
    title: '节点地区如何判断？延迟、速度与稳定性全攻略',
    summary: '名义单价与实际成本差异巨大。深入拆解IEPL专线、BGP调度与普通公网隧道的真实差距，告诉你何时无需为高价买单。'
  }
];
---

<Layout
  title="2026机场智选｜优质机场推荐、性价比套餐对比与理性选购指南"
  description="机场智选汇集18家热门机场品牌及146条套餐记录，提供机场推荐、便宜机场、Clash机场、翻墙机场、智能套餐筛选及价格对比，根据预算、流量和设备需求，帮助用户理性购买适合自己的机场服务。"
  canonical="https://jichangzhixuan.blog/"
>
  <!-- Single Semantic H1 for SEO -->
  <h1 class="sr-only">2026机场智选｜优质机场推荐与理性选购指南</h1>

  <!-- ========================================================= -->
  <!-- 01. HERO SECTION: Apple-style Minimalist Tech Hero       -->
  <!-- ========================================================= -->
  <section class="hero-section">
    <div class="max-container">
      <div class="hero-grid">
        <!-- Hero Left Column: Brand Copy & CTAs -->
        <div class="hero-left-col">
          <!-- Small Badge -->
          <div class="hero-badge-wrap">
            <span class="hero-badge">
              <span class="hero-badge-dot"></span>
              SmartChoice MAX · 智选旗舰
            </span>
          </div>

          <!-- Giant Visual Heading -->
          <h2 class="hero-display-title">
            帮你更聪明地选择<br/>
            合适的机场品牌与套餐
          </h2>

          <!-- Subtitle Copy -->
          <p class="hero-subtitle">
            专注于机场（科学上网）品牌评测、套餐对比与选购指南，用专业、客观、易懂的内容，帮助你在众多选择中找到更稳定、更高性价比的方案。
          </p>

          <!-- Action Buttons -->
          <div class="hero-buttons-row">
            <a href="#smart-filter" class="btn-hero-primary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M12 3v3m0 12v3M4.22 4.22l2.12 2.12m11.32 11.32 2.12 2.12M1 12h3m16 0h3M4.22 19.78l2.12-2.12m11.32-11.32 2.12-2.12"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
              <span>开始智能筛选 →</span>
            </a>
            
            <a href="#brand-recommendations" class="btn-hero-secondary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
              </svg>
              <span>查看品牌推荐</span>
            </a>
          </div>
        </div>

        <!-- Hero Right Column: Terminal Window View -->
        <div class="hero-right-col">
          <div class="hero-window-card">
            <img
              src="/images/hero/airport-terminal.webp"
              alt="机场智选现代化候机楼与停机坪全景视角"
              class="hero-terminal-img"
              width="600"
              height="380"
              loading="eager"
            />
            <div class="hero-window-overlay">
              <div class="hero-overlay-tag">
                <span class="live-pulse"></span>
                <span>全天候网络线路监测已接入</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================= -->
  <!-- 02. SECTION: 智能选机场 (Split Column + 4 Dropdown Cards)   -->
  <!-- ========================================================= -->
  <section id="smart-filter" class="section-container">
    <div class="max-container">
      <div class="split-layout">
        <!-- Left Column: Title & Description -->
        <div class="split-left">
          <div class="split-title-group">
            <span class="emerald-indicator-bar"></span>
            <h2 class="split-heading">智能选机场</h2>
          </div>
          <p class="split-desc">
            告诉我们你的使用需求，快速找到更适合的机场品牌与套餐。
          </p>
          <a href="/smart-match/" class="split-action-link" style="margin-top: 16px; display: inline-flex;">
            进入全功能匹配器 →
          </a>
        </div>

        <!-- Right Column: 4 Dropdown Selector Cards -->
        <div class="split-right">
          <form action="/smart-match/" method="GET" class="filter-cards-grid">
            <!-- Card 1: 预算范围 -->
            <div class="filter-card">
              <div class="filter-card-header">
                <div class="filter-icon-box">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="4" width="20" height="16" rx="3"/>
                    <path d="M16 8v.01M12 12v.01M8 16v.01"/>
                  </svg>
                </div>
                <span class="filter-title">预算范围</span>
              </div>
              <div class="filter-select-wrap">
                <select name="budget" class="filter-select" aria-label="预算范围筛选">
                  <option value="all">你期望的月度预算? ▾</option>
                  <option value="under20">¥20/月及以下 (平价亲民)</option>
                  <option value="under30">¥20 - ¥30/月 (主流均衡)</option>
                  <option value="30to60">¥30 - ¥60/月 (高阶大流量)</option>
                  <option value="above60">¥60/月以上 (企业定制)</option>
                </select>
              </div>
            </div>

            <!-- Card 2: 流量需求 -->
            <div class="filter-card">
              <div class="filter-card-header">
                <div class="filter-icon-box">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                  </svg>
                </div>
                <span class="filter-title">流量需求</span>
              </div>
              <div class="filter-select-wrap">
                <select name="traffic" class="filter-select" aria-label="流量需求筛选">
                  <option value="all">你每月大概用多少流量? ▾</option>
                  <option value="50">50GB / 月 (日常轻度)</option>
                  <option value="100">100GB / 月 (主流标准)</option>
                  <option value="200">200GB / 月 (影音流媒体)</option>
                  <option value="500">500GB+ / 月 (重度大流量)</option>
                </select>
              </div>
            </div>

            <!-- Card 3: 设备数量 -->
            <div class="filter-card">
              <div class="filter-card-header">
                <div class="filter-icon-box">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="3" width="20" height="14" rx="2"/>
                    <line x1="8" y1="21" x2="16" y2="21"/>
                    <line x1="12" y1="17" x2="12" y2="21"/>
                  </svg>
                </div>
                <span class="filter-title">设备数量</span>
              </div>
              <div class="filter-select-wrap">
                <select name="device" class="filter-select" aria-label="设备数量筛选">
                  <option value="all">需要同时使用几台设备? ▾</option>
                  <option value="1-2">1 - 2 台设备 (单人自用)</option>
                  <option value="3-5">3 - 5 台设备 (多设备联动)</option>
                  <option value="unlimited">不限设备数 (家庭/合租)</option>
                </select>
              </div>
            </div>

            <!-- Card 4: 使用场景 -->
            <div class="filter-card">
              <div class="filter-card-header">
                <div class="filter-icon-box">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="12 2 2 7 12 12 22 7 12 2"/>
                    <polyline points="2 17 12 22 22 17"/>
                    <polyline points="2 12 12 17 22 12"/>
                  </svg>
                </div>
                <span class="filter-title">使用场景</span>
              </div>
              <div class="filter-select-wrap">
                <select name="scenario" class="filter-select" aria-label="使用场景筛选">
                  <option value="all">主要用于哪些场景? ▾</option>
                  <option value="web">日常网页与学术文献</option>
                  <option value="ai">ChatGPT / Claude 等 AI 开发</option>
                  <option value="video">YouTube / Netflix 4K 影音</option>
                  <option value="clash">支持第三方 Clash 订阅导入</option>
                </select>
              </div>
            </div>

            <!-- Submit action bar span across columns -->
            <div class="filter-action-bar">
              <div class="filter-status-info">
                <span class="check-green">✓</span>
                <span>已接入 18 家机场真实数据档案，算法实时过滤</span>
              </div>
              <button type="submit" class="btn-filter-submit">
                <span>立即智能匹配套餐 →</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================= -->
  <!-- 03. SECTION: 品牌推荐 (Split Column + 3 Brand Cards)         -->
  <!-- ========================================================= -->
  <section id="brand-recommendations" class="section-container" style="background: #FFFFFF;">
    <div class="max-container">
      <div class="split-layout">
        <!-- Left Column -->
        <div class="split-left">
          <div class="split-title-group">
            <span class="emerald-indicator-bar"></span>
            <h2 class="split-heading">品牌推荐</h2>
          </div>
          <p class="split-desc">
            精选口碑优秀的机场品牌，从稳定性、速度、性价比等维度为你推荐值得关注的选择。
          </p>
          <a href="/airports/" class="split-action-btn">
            <span>查看更多品牌 →</span>
          </a>
        </div>

        <!-- Right Column: 3 Top Brand Cards -->
        <div class="split-right">
          <div class="brand-cards-grid">
            <!-- Brand 1: 灵动云 -->
            <div class="brand-showcase-card">
              <a href="/airports/lingdongyun/" class="brand-cover-link">
                <div class="brand-banner-wrap">
                  <img
                    src="/images/brands/banner-lingdong.webp"
                    alt="灵动云雪山全速线路评测封面"
                    class="brand-banner-img"
                    width="400"
                    height="200"
                    loading="lazy"
                  />
                  <div class="brand-banner-badge">
                    <span class="brand-badge-icon">⚡</span>
                    <span>灵动云 Varnexa</span>
                  </div>
                </div>
              </a>
              <div class="brand-card-body">
                <h3 class="brand-card-title">
                  <a href="/airports/lingdongyun/">灵动云 机场评测：稳定高速的全能型选择</a>
                </h3>
                <div class="brand-tags-row">
                  <span class="brand-tag">高稳定</span>
                  <span class="brand-tag">多地区</span>
                  <span class="brand-tag">性价比优</span>
                </div>
                <div class="brand-price-preview">
                  <span>月付入门：<strong>¥20/月</strong> (100GB)</span>
                  <a href="/airports/lingdongyun/" class="brand-detail-link">查看详情 →</a>
                </div>
              </div>
            </div>

            <!-- Brand 2: 暮光加速 -->
            <div class="brand-showcase-card">
              <a href="/airports/twilight/" class="brand-cover-link">
                <div class="brand-banner-wrap">
                  <img
                    src="/images/brands/banner-twilight.webp"
                    alt="暮光加速机翼云海极速专线封面"
                    class="brand-banner-img"
                    width="400"
                    height="200"
                    loading="lazy"
                  />
                  <div class="brand-banner-badge">
                    <span class="brand-badge-icon">✈</span>
                    <span>暮光加速 Twilight</span>
                  </div>
                </div>
              </a>
              <div class="brand-card-body">
                <h3 class="brand-card-title">
                  <a href="/airports/twilight/">暮光加速 评测：兼顾速度与性价比的热门品牌</a>
                </h3>
                <div class="brand-tags-row">
                  <span class="brand-tag">高性价比</span>
                  <span class="brand-tag">节点丰富</span>
                  <span class="brand-tag">适合长期使用</span>
                </div>
                <div class="brand-price-preview">
                  <span>月付入门：<strong>¥20/月</strong> (120GB)</span>
                  <a href="/airports/twilight/" class="brand-detail-link">查看详情 →</a>
                </div>
              </div>
            </div>

            <!-- Brand 3: 微风网络 -->
            <div class="brand-showcase-card">
              <a href="/airports/breezenet/" class="brand-cover-link">
                <div class="brand-banner-wrap">
                  <img
                    src="/images/brands/banner-breeze.webp"
                    alt="微风网络全球轨道网络连接封面"
                    class="brand-banner-img"
                    width="400"
                    height="200"
                    loading="lazy"
                  />
                  <div class="brand-banner-badge">
                    <span class="brand-badge-icon">🌐</span>
                    <span>微风网络 BreezeNet</span>
                  </div>
                </div>
              </a>
              <div class="brand-card-body">
                <h3 class="brand-card-title">
                  <a href="/airports/breezenet/">微风网络 评测：国际线路覆盖广，适合多场景使用</a>
                </h3>
                <div class="brand-tags-row">
                  <span class="brand-tag">全球节点</span>
                  <span class="brand-tag">稳定可靠</span>
                  <span class="brand-tag">多设备支持</span>
                </div>
                <div class="brand-price-preview">
                  <span>月付入门：<strong>¥25/月</strong> (200GB)</span>
                  <a href="/airports/breezenet/" class="brand-detail-link">查看详情 →</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================= -->
  <!-- 04. SECTION: 套餐对比 (Split Column + 3 Tier Pricing Cards) -->
  <!-- ========================================================= -->
  <section id="plan-comparison" class="section-container">
    <div class="max-container">
      <div class="split-layout">
        <!-- Left Column -->
        <div class="split-left">
          <div class="split-title-group">
            <span class="emerald-indicator-bar"></span>
            <h2 class="split-heading">套餐对比</h2>
          </div>
          <p class="split-desc">
            主流套餐方案一目了然，帮你从价格、流量、时长与适用人群等维度快速比较，选出更划算的方案。
          </p>
          <a href="/compare/" class="split-action-btn">
            <span>查看完整套餐对比 →</span>
          </a>
        </div>

        <!-- Right Column: 3 Pricing Tier Cards -->
        <div class="split-right">
          <div class="pricing-tiers-grid">
            <!-- Tier 1: 月付套餐 -->
            <div class="pricing-tier-card">
              <div class="tier-card-header">
                <div class="tier-icon-wrap">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                  </svg>
                </div>
                <h3 class="tier-title">月付套餐</h3>
              </div>

              <div class="tier-price-row">
                <span class="tier-currency">¥</span>
                <span class="tier-amount">29</span>
                <span class="tier-period">/月起</span>
              </div>

              <ul class="tier-features-list">
                <li>
                  <span class="tier-check">✓</span>
                  <span>灵活订阅，随用随停</span>
                </li>
                <li>
                  <span class="tier-check">✓</span>
                  <span>适合短期体验或轻度用户</span>
                </li>
                <li>
                  <span class="tier-check">✓</span>
                  <span>多数品牌提供基础线路</span>
                </li>
              </ul>

              <a href="/monthly-airports/" class="btn-tier-action btn-tier-outline">
                <span>查看详情 →</span>
              </a>
