---
import Layout from '../../../layouts/Layout.astro';
import brands from '../../../data/brands.json';
import options from '../../../data/options.json';

const pageTitle = "机场流量需求计算器｜精准测算月度流量与套餐推荐";
const pageDesc = "根据每日网页浏览、视频播放清晰度（1080P/4K）、AI交互、下载量及节点倍率，量化测算每月实际所需的机场流量，并匹配合适套餐。";
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonical="https://jichangzhixuan.blog/tools/traffic-calculator/"
  breadcrumbs={[
    { name: '智选工具', url: '/tools/' },
    { name: '流量需求计算器', url: '/tools/traffic-calculator/' }
  ]}
>
  <section style="background: linear-gradient(180deg, #F4F9FC 0%, #FFFFFF 100%); padding: 56px 0 40px 0; border-bottom: 1px solid #DCE7EC;">
    <div class="max-container">
      <div style="max-width: 820px;">
        <span class="badge-pill" style="margin-bottom: 12px;">量化测算工具</span>
        <h1 style="font-size: clamp(32px, 4.5vw, 48px); font-weight: 900; color: #102D46; line-height: 1.2; margin-bottom: 16px;">
          机场月度流量需求计算器
        </h1>
        <p style="font-size: 16.5px; color: #647B8C; line-height: 1.8;">
          避免“凭感觉估算”导致的流量过剩浪费或月中枯竭断网。通过日常上网行为量化模型，测算每月的真实流量需求。
        </p>
      </div>
    </div>
  </section>

  <section class="section-gap" style="background: #FFFFFF;">
    <div class="max-container">
      <div style="display: grid; grid-template-columns: 1fr; gap: 40px;">
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 32px; align-items: start;">
          
          <!-- Input Controls -->
          <div class="smart-card" style="padding: 32px; background: #F8FBFE; border: 1.5px solid #DCE7EC;">
            <h2 style="font-size: 20px; font-weight: 800; color: #102D46; margin-bottom: 24px;">
              📊 上网行为参数设置
            </h2>

            <div style="display: flex; flex-direction: column; gap: 20px;">
              
              <!-- Web Browsing -->
              <div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 6px; font-size: 14px; font-weight: 600; color: #263E50;">
                  <span>每日网页/社媒浏览时长</span>
                  <span id="web-hours-val" style="color: #07886E; font-weight: 700;">2 小时</span>
                </div>
                <input id="web-hours" type="range" min="0" max="10" step="0.5" value="2" style="width: 100%; accent-color: #10B89A;" />
                <div style="font-size: 12px; color: #8BA0B2; margin-top: 4px;">基准：普通图文网页约 150MB / 小时</div>
              </div>

              <!-- Video Streaming -->
              <div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 6px; font-size: 14px; font-weight: 600; color: #263E50;">
                  <span>每日视频观看时长</span>
                  <span id="video-hours-val" style="color: #07886E; font-weight: 700;">1.5 小时</span>
                </div>
                <input id="video-hours" type="range" min="0" max="8" step="0.5" value="1.5" style="width: 100%; accent-color: #10B89A;" />
              </div>

              <!-- Video Resolution -->
              <div>
                <label style="display: block; font-size: 14px; font-weight: 600; color: #263E50; margin-bottom: 6px;">
                  常用视频清晰度
                </label>
                <select id="video-quality" style="width: 100%; padding: 10px 12px; border-radius: 10px; border: 1px solid #DCE7EC; background: #FFFFFF; font-size: 14px;">
                  <option value="720">720P 高清 (约 0.9 GB / 小时)</option>
                  <option value="1080" selected>1080P 全高清 (约 1.8 GB / 小时)</option>
                  <option value="4k">4K 超高清 (约 7.0 GB / 小时)</option>
                </select>
              </div>

              <!-- AI Tools -->
              <div>
                <label style="display: block; font-size: 14px; font-weight: 600; color: #263E50; margin-bottom: 6px;">
                  AI 工具交互频率 (ChatGPT / Claude)
                </label>
                <select id="ai-usage" style="width: 100%; padding: 10px 12px; border-radius: 10px; border: 1px solid #DCE7EC; background: #FFFFFF; font-size: 14px;">
                  <option value="none">不使用 / 极少使用</option>
                  <option value="moderate" selected>日常文本交互 (预计 2-5 GB / 月)</option>
                  <option value="heavy">频繁代码分析 / 绘图 (预计 10-20 GB / 月)</option>
                </select>
              </div>

              <!-- Extra Monthly Downloads -->
              <div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 6px; font-size: 14px; font-weight: 600; color: #263E50;">
                  <span>每月额外大文件下载量</span>
                  <span id="download-val" style="color: #07886E; font-weight: 700;">10 GB</span>
                </div>
                <input id="download-gb" type="range" min="0" max="200" step="5" value="10" style="width: 100%; accent-color: #10B89A;" />
              </div>

              <!-- Buffer & Multiplier -->
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                <div>
                  <label style="display: block; font-size: 13px; font-weight: 600; color: #263E50; margin-bottom: 6px;">安全预留缓冲</label>
                  <select id="buffer-pct" style="width: 100%; padding: 9px 12px; border-radius: 10px; border: 1px solid #DCE7EC; background: #FFFFFF; font-size: 13.5px;">
                    <option value="0.1">预留 10%</option>
                    <option value="0.2" selected>预留 20% (推荐)</option>
                    <option value="0.3">预留 30%</option>
                  </select>
                </div>
                <div>
                  <label style="display: block; font-size: 13px; font-weight: 600; color: #263E50; margin-bottom: 6px;">平均节点倍率</label>
                  <select id="multiplier" style="width: 100%; padding: 9px 12px; border-radius: 10px; border: 1px solid #DCE7EC; background: #FFFFFF; font-size: 13.5px;">
                    <option value="1.0" selected>1.0x 标准倍率</option>
                    <option value="1.2">1.2x 混合倍率</option>
                    <option value="1.5">1.5x 高峰专线</option>
                  </select>
                </div>
              </div>

            </div>
          </div>

          <!-- Calculation Results Display -->
          <div style="display: flex; flex-direction: column; gap: 24px;">
            
            <div class="smart-card" style="padding: 32px; background: #102D46; color: #FFFFFF; box-shadow: 0 16px 40px rgba(16, 45, 70, 0.15);">
              <span style="font-size: 12px; font-weight: 700; color: #10B89A; letter-spacing: 0.08em; text-transform: uppercase;">
                CALCULATION RESULT
              </span>
              <h3 style="font-size: 20px; font-weight: 700; color: #FFFFFF; margin-top: 4px; margin-bottom: 24px;">
                您的月度流量测算建议
              </h3>

              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px; background: rgba(255, 255, 255, 0.06); padding: 20px; border-radius: 16px; border: 1px solid rgba(255, 255, 255, 0.1);">
                <div>
                  <div style="font-size: 13px; color: #A4B8C7;">基础净消耗量</div>
                  <div id="base-traffic" style="font-size: 32px; font-weight: 900; color: #FFFFFF; line-height: 1.1; margin-top: 6px;">
                    0 <span style="font-size: 16px; font-weight: 600; color: #A4B8C7;">GB/月</span>
                  </div>
                </div>
                <div style="border-left: 1px solid rgba(255, 255, 255, 0.15); padding-left: 16px;">
                  <div style="font-size: 13px; color: #10B89A;">建议购买套餐额度</div>
                  <div id="recommended-traffic" style="font-size: 32px; font-weight: 900; color: #10B89A; line-height: 1.1; margin-top: 6px;">
                    0 <span style="font-size: 16px; font-weight: 600; color: #FFFFFF;">GB/月</span>
                  </div>
                </div>
              </div>

              <div style="font-size: 13.5px; color: #A4B8C7; line-height: 1.6; border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 16px;">
                💡 <strong>智选建议：</strong>
                <span id="advice-text">建议购买符合您月度实际消耗的套餐梯度，避免为用不完的配额买单。</span>
              </div>
            </div>

            <!-- Matching Plans List -->
            <div>
              <h3 style="font-size: 18px; font-weight: 800; color: #102D46; margin-bottom: 14px;">
                符合该流量区间的精选套餐
              </h3>
              <div id="matched-plans-container" style="display: flex; flex-direction: column; gap: 12px;">
                <!-- Populated by JS -->
              </div>
            </div>

          </div>

        </div>

      </div>
    </div>
  </section>

  <script define:vars={{ optionsData: options }}>
    const allOptions = optionsData;

    const webSlider = document.getElementById('web-hours');
    const webVal = document.getElementById('web-hours-val');
    const videoSlider = document.getElementById('video-hours');
    const videoVal = document.getElementById('video-hours-val');
    const qualitySelect = document.getElementById('video-quality');
    const aiSelect = document.getElementById('ai-usage');
    const downloadSlider = document.getElementById('download-gb');
    const downloadVal = document.getElementById('download-val');
    const bufferSelect = document.getElementById('buffer-pct');
    const multiplierSelect = document.getElementById('multiplier');

    const baseDisplay = document.getElementById('base-traffic');
    const recDisplay = document.getElementById('recommended-traffic');
    const adviceDisplay = document.getElementById('advice-text');
    const plansContainer = document.getElementById('matched-plans-container');

    function calculate() {
      const webH = parseFloat(webSlider.value);
      webVal.textContent = `${webH} 小时`;
      const videoH = parseFloat(videoSlider.value);
      videoVal.textContent = `${videoH} 小时`;
      const dlGB = parseFloat(downloadSlider.value);
      downloadVal.textContent = `${dlGB} GB`;

      // Rates (GB/hr)
      const webRate = 0.15; // 150MB
      let videoRate = 1.8; // 1080p
      if (qualitySelect.value === '720') videoRate = 0.9;
      else if (qualitySelect.value === '4k') videoRate = 7.0;

      let aiMonthly = 3;
      if (aiSelect.value === 'none') aiMonthly = 0.5;
      else if (aiSelect.value === 'heavy') aiMonthly = 15;

      const dailyNet = (webH * webRate) + (videoH * videoRate);
      const monthlyNet = (dailyNet * 30) + aiMonthly + dlGB;

      const buffer = parseFloat(bufferSelect.value);
      const mult = parseFloat(multiplierSelect.value);

      const recommended = Math.ceil(monthlyNet * (1 + buffer) * mult);

      baseDisplay.innerHTML = `${Math.round(monthlyNet)} <span style="font-size: 16px; font-weight: 600; color: #A4B8C7;">GB/月</span>`;
      recDisplay.innerHTML = `${recommended} <span style="font-size: 16px; font-weight: 600; color: #FFFFFF;">GB/月</span>`;

      if (recommended <= 70) {
        adviceDisplay.textContent = '您的流量需求较为轻度，建议重点关注 50GB-100GB 的低价月付（如 ¥15-¥20）或百元以内轻量年付，性价比最高。';
      } else if (recommended <= 180) {
        adviceDisplay.textContent = '您属于主流均衡型用户，建议选择 120GB-200GB 档位（如 ¥20-¥30/月），既能保证影音流畅，又不会造成大额闲置。';
      } else {
        adviceDisplay.textContent = '您属于大流量/频繁高清视频用户，建议选择 300GB 以上的大容量月付或 500GB+ 进阶档位，注意核查节点倍率。';
      }

      // Filter 3 matching options around the recommended value
      const suitable = allOptions
        .filter(o => o.monthlyTrafficGB && o.monthlyTrafficGB >= recommended && o.monthlyTrafficGB <= recommended * 2.2)
        .slice(0, 4);

      if (suitable.length === 0) {
        plansContainer.innerHTML = '<div style="font-size: 13.5px; color: #647B8C;">可前往全部套餐库筛选更多档位。</div>';
      } else {
        plansContainer.innerHTML = suitable.map(p => `
          <div class="smart-card" style="padding: 16px 20px; display: flex; align-items: center; justify-content: space-between;">
            <div>
              <div style="font-size: 12px; color: #10B89A; font-weight: 700;">${p.brandName}</div>
              <div style="font-size: 15px; font-weight: 700; color: #102D46;">${p.planName} · ${p.trafficText}</div>
              <div style="font-size: 12.5px; color: #647B8C;">实付 ¥${p.totalPrice} (${p.periodName})</div>
            </div>
            <a href="/airports/${p.brandId}/" class="btn-primary" style="padding: 7px 14px; font-size: 13px;">
              查看套餐
            </a>
          </div>
        `).join('');
      }
    }

    [webSlider, videoSlider, qualitySelect, aiSelect, downloadSlider, bufferSelect, multiplierSelect].forEach(el => {
      el.addEventListener('input', calculate);
    });

    calculate();
  </script>
</Layout>
