---
import Layout from '../../layouts/Layout.astro';
import brands from '../../data/brands.json';
import options from '../../data/options.json';

const pageTitle = "2026 Clash机场推荐与第三方订阅开放政策分析｜机场智选";
const pageDesc = "支持Clash、Mihomo、Shadowrocket、Sing-box的机场推荐。重点核实各品牌是否开放通用订阅直链、是否有申请门槛及导入教程。";
