---
import Layout from '../../layouts/Layout.astro';
import brands from '../../data/brands.json';
import rankings from '../../data/rankings.json';

const pageTitle = "2026机场智选品牌排行榜｜优质稳定机场综合推荐与评选依据";
const pageDesc = "2026机场品牌编辑推荐排行榜。收录灵动云、暮光加速、微风网络等18家机场品牌，公开评测排序规则、月付与年付起步价、优缺点及避坑指南，帮您理性决策。";
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonical="https://jichangzhixuan.blog/ranking/"
  breadcrumbs={[
    { name: '推荐榜单', url: '/ranking/' }
  ]}
>
  <section style="background: linear-gradient(180deg, #F4F9FC 0%, #FFFFFF 100%); padding: 56px 0 40px 0; border-bottom: 1px solid #DCE7EC;">
    <div class="max-container">
      <div style="max-width: 820px;">
        <span class="badge-pill" style="margin-bottom: 12px;">编辑推荐榜</span>
        <h1 style="font-size: clamp(32px, 4.5vw, 48px); font-weight: 900; color: #102D46; line-height: 1.2; margin-bottom: 16px;">
          2026 机场智选品牌排行榜
        </h1>
        <p style="font-size: 16.5px; color: #647B8C; line-height: 1.8; margin-bottom: 20px;">
          本榜单为站长指定的编辑推荐顺序。特别说明：FLYV 与浪网并列第六。本排名旨在为用户提供清晰的参考脉络，不作为绝对网络性能测速榜或商业广告排位。
        </p>
        <div style="padding: 14px 18px; background: #E4F0F6; border-left: 4px solid #10B89A; border-radius: 0 10px 10px 0; font-size: 14px; color: #102D46;">
          <strong>推荐原则公开：</strong> 我们综合考量了各品牌的套餐价格透明度、月付起步门槛、线路协议、客户端兼容及客服渠道健全度。用户在使用本站「智能匹配」工具时，结果将严格由算法和个人输入条件计算，不受此编辑榜单影响。
        </div>
      </div>
    </div>
  </section>

  <section class="section-gap" style="background: #FFFFFF;">
    <div class="max-container">
      
      <div style="display: flex; flex-direction: column; gap: 24px;">
        {rankings.map(b => {
          const brandObj = brands.find(x => x.slug === b.slug)!;
          const isTop3 = b.rank <= 3;
          return (
            <div class="smart-card" style={`padding: 28px; border-left: 6px solid ${isTop3 ? '#10B89A' : '#DCE7EC'};`}>
              <div style="display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 20px;">
                
                <div style="display: flex; gap: 20px; max-width: 760px;">
                  <!-- Rank Number Badge -->
                  <div style={`width: 56px; height: 56px; border-radius: 16px; background: ${isTop3 ? '#102D46' : '#F4F9FC'}; color: ${isTop3 ? '#10B89A' : '#102D46'}; font-size: 24px; font-weight: 900; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 1.5px solid ${isTop3 ? '#10B89A' : '#DCE7EC'};`}>
                    #{b.rank < 10 ? `0${b.rank}` : b.rank}
                  </div>

                  <div>
                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 6px;">
                      <h2 style="font-size: 22px; font-weight: 800; color: #102D46; margin: 0;">
                        <a href={`/airports/${b.slug}/`} style="color: inherit; text-decoration: none;">{b.name}</a>
                      </h2>
                      <span class="badge-pill" style="font-size: 12px;">{b.badge}</span>
                      <span style="font-size: 13.5px; color: #647B8C;">{b.englishName}</span>
                    </div>

                    <p style="font-size: 14.5px; color: #647B8C; line-height: 1.6; margin-bottom: 12px;">
                      {b.tagline}
                    </p>

                    <div style="display: flex; flex-wrap: wrap; gap: 16px; font-size: 13.5px; margin-bottom: 14px;">
                      <div>
                        <span style="color: #647B8C;">月付入门：</span>
                        <strong style="color: #102D46;">{b.minMonthlyPrice ? `¥${b.minMonthlyPrice}/月` : '无直购月付'}</strong>
                      </div>
                      <div>
                        <span style="color: #647B8C;">年付门槛：</span>
                        <strong style="color: #07886E;">{b.minYearlyPrice ? `¥${b.minYearlyPrice}/年` : '无独立年付'}</strong>
                      </div>
                      <div>
                        <span style="color: #647B8C;">线路协议：</span>
                        <span>{b.networkTypes.join(' / ')}</span>
                      </div>
                    </div>

                    <!-- Advantages preview -->
                    <div style="font-size: 13.5px; color: #263E50; display: flex; flex-direction: column; gap: 4px;">
                      {b.advantages.map((adv: string) => (
                        <div style="display: flex; gap: 6px;">
                          <span style="color: #10B89A;">✓</span>
                          <span>{adv}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>

                <!-- Actions -->
                <div style="display: flex; flex-direction: column; gap: 10px; width: 100%; max-width: 200px;">
                  <a href={`/airports/${b.slug}/`} class="btn-secondary" style="width: 100%; padding: 10px 0; font-size: 14px; text-align: center;">
                    查看完整评测
                  </a>
                  <a href={b.purchaseUrl} target="_blank" rel="sponsored nofollow noopener" class="btn-primary" style="width: 100%; padding: 10px 0; font-size: 14px; text-align: center;">
                    访问品牌官网
                  </a>
                </div>

              </div>
            </div>
          );
        })}
      </div>

    </div>
  </section>
</Layout>
