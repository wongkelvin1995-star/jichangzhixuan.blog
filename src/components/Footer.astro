          <li><a href="/terms/" style="color: #A4B8C7; font-size: 14px; text-decoration: none;" class="footer-link">使用条款</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div style="border-top: 1px solid rgba(220, 231, 236, 0.15); padding-top: 24px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; font-size: 13px; color: #8BA0B2;">
