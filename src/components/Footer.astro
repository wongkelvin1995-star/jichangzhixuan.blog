        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 11px;">
          <li><a href="/airports/" style="color: #A4B8C7; font-size: 14px; text-decoration: none;" class="footer-link">精选品牌大全</a></li>
          <li><a href="/ranking/" style="color: #A4B8C7; font-size: 14px; text-decoration: none;" class="footer-link">2026机场排行榜</a></li>
          <li><a href="/cheap-airports/" style="color: #A4B8C7; font-size: 14px; text-decoration: none;" class="footer-link">便宜机场选购</a></li>
          <li><a href="/value-airports/" style="color: #A4B8C7; font-size: 14px; text-decoration: none;" class="footer-link">高性价比机场推荐</a></li>
          <li><a href="/stable-airports/" style="color: #A4B8C7; font-size: 14px; text-decoration: none;" class="footer-link">稳定机场理性选购</a></li>
          <li><a href="/clash-airports/" style="color: #A4B8C7; font-size: 14px; text-decoration: none;" class="footer-link">Clash机场订阅分析</a></li>
        </ul>
      </div>

      <!-- Col 3: Smart Tools -->
      <div>
        <h4 style="font-size: 15px; font-weight: 700; color: #FFFFFF; margin-bottom: 18px; letter-spacing: 0.02em;">智选工具中心</h4>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 11px;">
          <li><a href="/smart-match/" style="color: #A4B8C7; font-size: 14px; text-decoration: none;" class="footer-link">Smart Match 智能选机场</a></li>
          <li><a href="/tools/traffic-calculator/" style="color: #A4B8C7; font-size: 14px; text-decoration: none;" class="footer-link">月度流量需求计算器</a></li>
