---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { name: '首页', href: '/' },
  { name: '品牌推荐', href: '/airports/' },
  { name: '套餐对比', href: '/compare/' },
  { name: '专题文章', href: '/articles/' },
  { name: 'FAQ', href: '/#faq' },
  { name: '最新文章', href: '/articles/' }
];
---

<header class="floating-header-wrapper">
  <div class="floating-pill-nav">
    <!-- Brand Logo -->
    <a href="/" class="brand-logo-link" aria-label="机场智选首页">
      <div class="brand-logo-badge">
        <svg class="airplane-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.3c.4-.2.6-.6.5-1.1z"/>
        </svg>
      </div>
      <div class="brand-text-col">
        <div class="brand-title">
          机场智选 <span class="brand-sub">/ Airport Smart Choice</span>
        </div>
        <div class="brand-domain">jichangzhixuan.blog</div>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="desktop-nav-links" aria-label="主导航">
      {navItems.map(item => {
        const isActive = (item.href === '/' && currentPath === '/') || 
                         (item.href !== '/' && item.href !== '/#faq' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`nav-pill-item ${isActive ? 'nav-pill-active' : ''}`}
          >
            {item.name}
          </a>
        );
      })}
    </nav>

    <!-- Right Actions: Tools, Search & Mobile Toggle -->
    <div class="nav-right-actions">
      <a
        href="/smart-match/"
        class="nav-quick-cta"
        title="快速进入智能选机场"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
        </svg>
        <span>智能选购</span>
      </a>

      <a
        href="/search/"
        aria-label="站内搜索"
        class="search-icon-btn"
        title="搜索机场与套餐"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="打开导航菜单"
        class="mobile-toggle-btn"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="mobile-dropdown-pane" style="display: none;">
    <div style="display: flex; flex-direction: column; gap: 8px;">
      {navItems.map(item => (
        <a
          href={item.href}
          class={`mobile-nav-link ${currentPath === item.href ? 'mobile-nav-active' : ''}`}
        >
          {item.name}
        </a>
      ))}
      <div style="height: 1px; background: #DCE7EC; margin: 4px 0;"></div>
      <a href="/smart-match/" class="mobile-nav-link" style="color: #07886E; font-weight: 700;">
        ✨ 智能选机场
      </a>
      <a href="/tools/" class="mobile-nav-link">
        🛠 智选工具中心
      </a>
      <a href="/search/" class="mobile-nav-link">
        🔍 站内快速搜索
      </a>
    </div>
  </div>
</header>

<style>
  .floating-header-wrapper {
    position: sticky;
    top: 14px;
    z-index: 1000;
    width: 100%;
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 16px;
    padding-right: 16px;
  }

  .floating-pill-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    padding: 0 14px 0 18px;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(220, 231, 236, 0.85);
    border-radius: 9999px;
    box-shadow: 0 8px 30px rgba(16, 45, 70, 0.06);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .floating-pill-nav:hover {
    box-shadow: 0 12px 36px rgba(16, 45, 70, 0.1);
    border-color: rgba(16, 184, 154, 0.35);
  }

  .brand-logo-link {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-logo-badge {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: #E4F0F6;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #10B89A;
    transition: transform 0.25s ease;
  }

  .brand-logo-link:hover .brand-logo-badge {
    transform: rotate(6deg) scale(1.05);
    background: #10B89A;
    color: #FFFFFF;
  }

  .airplane-icon {
    width: 18px;
    height: 18px;
  }

  .brand-text-col {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-title {
    font-size: 15px;
    font-weight: 800;
    color: #102D46;
    letter-spacing: -0.01em;
  }

  .brand-sub {
    font-size: 11.5px;
    font-weight: 500;
    color: #647B8C;
  }

  .brand-domain {
    font-size: 10.5px;
    font-weight: 500;
    color: #8FA2B0;
    letter-spacing: 0.02em;
  }

  .desktop-nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    background: rgba(244, 249, 252, 0.7);
    padding: 4px 6px;
    border-radius: 9999px;
    border: 1px solid rgba(220, 231, 236, 0.6);
  }

  .nav-pill-item {
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 14.5px;
    font-weight: 500;
    color: #263E50;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .nav-pill-item:hover {
    color: #07886E;
    background: rgba(228, 240, 246, 0.8);
  }

  .nav-pill-active {
    background: #10B89A !important;
    color: #FFFFFF !important;
    font-weight: 700 !important;
    box-shadow: 0 3px 12px rgba(16, 184, 154, 0.35);
  }

  .nav-right-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-quick-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 9999px;
    background: #102D46;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .nav-quick-cta:hover {
    background: #07886E;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(16, 184, 154, 0.25);
  }

  .search-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #F4F9FC;
    border: 1px solid #DCE7EC;
    color: #102D46;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .search-icon-btn:hover {
    background: #E4F0F6;
    color: #07886E;
    border-color: #10B89A;
  }

  .mobile-toggle-btn {
    display: none;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 6px;
    color: #102D46;
  }

  .mobile-dropdown-pane {
    margin-top: 10px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid #DCE7EC;
    border-radius: 20px;
    padding: 16px;
    box-shadow: 0 14px 40px rgba(16, 45, 70, 0.12);
  }

  .mobile-nav-link {
    padding: 9px 14px;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 500;
    color: #263E50;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .mobile-nav-link:hover, .mobile-nav-active {
    background: #E4F0F6;
    color: #07886E;
    font-weight: 700;
  }

  @media (max-width: 960px) {
    .desktop-nav-links {
      display: none;
    }
    .nav-quick-cta {
      display: none;
    }
    .mobile-toggle-btn {
      display: block;
    }
    .brand-sub {
      display: none;
    }
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isHidden = menu.style.display === 'none';
      menu.style.display = isHidden ? 'block' : 'none';
    });
  }
</script>